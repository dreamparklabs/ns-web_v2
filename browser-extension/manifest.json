{
  "manifest_version": 3,
  "name": "Northstar D2L Sync",
  "version": "1.0.0",
  "description": "Securely sync your D2L Brightspace data with Northstar",
  
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  
  "host_permissions": [
    "https://*.brightspace.com/*",
    "https://*.siu.edu/*",
    "https://*.edu/*",
    "http://localhost:5173/*"
  ],
  
  "background": {
    "service_worker": "background-simple.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://*.brightspace.com/*",
        "https://mycourses.siu.edu/*",
        "https://*.siu.edu/*",
        "https://*.edu/*",
        "http://localhost:5173/*"
      ],
      "js": ["content-simple.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  
  "action": {
    "default_popup": "popup-simple.html",
    "default_title": "Northstar D2L Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": []
}
